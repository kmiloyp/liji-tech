# Copie este archivo como .env.local y complete los valores.
# En Vercel: Project Settings > Environment Variables.

# Dominio final, sin barra al final. Mientras no exista, déjelo vacío:
# el sitio usa la URL de producción que asigna Vercel.
NEXT_PUBLIC_SITE_URL=

# WhatsApp de la dueña: solo dígitos, con código de país (ej. 13053030985).
# Si se deja vacío, los botones de WhatsApp usan el teléfono de abajo.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Teléfono (obligatorio).
NEXT_PUBLIC_PHONE_E164=+13053030985
NEXT_PUBLIC_PHONE_DISPLAY=(305) 303-0985

# Opcionales
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
